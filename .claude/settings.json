{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(drizzle-kit push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(npm run db:push*)",
      "Bash(pnpm run db:push*)",
      "Bash(yarn db:push*)",
      "Bash(npm run setup*)",
      "Bash(npm run db:seed*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:backfill-capabilities*)",
      "Bash(tsx db/migrate.ts*)",
      "Bash(tsx db/seed.ts*)",
      "Bash(turso db shell*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.zshrc)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.git/**)",
      "mcp__turso__execute_query",
      "mcp__turso__create_database",
      "mcp__turso__delete_database",
      "mcp__turso__generate_database_token",
      "mcp__vercel__deploy_to_vercel",
      "mcp__vercel__buy_domain",
      "mcp__vercel__buy_pro",
      "mcp__vercel__buy_credits",
      "mcp__vercel__buy_addon",
      "mcp__vercel__pause_project",
      "mcp__vercel__unpause_project",
      "mcp__vercel__update_project_deployment_protection",
      "Bash(atlas-db*)",
      "Bash(*atlas-db *)"
    ],
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run dev*)",
      "Bash(npm ci*)",
      "Bash(npm run db:generate*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git fetch*)",
      "mcp__turso__execute_read_only_query",
      "mcp__turso__list_databases",
      "mcp__turso__list_tables",
      "mcp__turso__describe_table",
      "mcp__vercel__list_deployments",
      "mcp__vercel__get_deployment",
      "mcp__vercel__get_deployment_build_logs",
      "mcp__vercel__list_projects",
      "mcp__vercel__get_project"
    ]
  }
}
